{
  "name": "quote-poster-generator",
  "description": "Generate typographic quote posters in your browser.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ilancohen/quote-poster-generator.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=14.17"
  },
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,css}\" index.html package.json .prettierrc .github/workflows/ci.yml",
    "format:check": "prettier --check \"src/**/*.{js,css}\" index.html package.json .prettierrc .github/workflows/ci.yml"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "^5.8.3"
  }
}
